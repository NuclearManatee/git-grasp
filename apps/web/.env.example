# PostHog EU Cloud — public project API key. Empty until the project is created
# (snippet and CLI send no-op). Same key as GIT_GRASP_POSTHOG_KEY.
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# PUBLIC_POSTHOG_KEY=phc_...

# EVOLVE pull (pipeline). Query API host is eu.posthog.com (not the ingest host).
# GIT_GRASP_POSTHOG_HOST=https://eu.i.posthog.com
# GIT_GRASP_POSTHOG_API_HOST=https://eu.posthog.com
# GIT_GRASP_POSTHOG_KEY=phc_...
# GIT_GRASP_POSTHOG_PROJECT_ID=
# GIT_GRASP_POSTHOG_PERSONAL_API_KEY=

# Local Docker e2e (ingest + query share one host). Start compose, then seed:
#   docker compose -f apps/web/docker-compose.posthog.yml --profile e2e up -d
#   bun run evolve:seed-posthog
# PUBLIC_POSTHOG_HOST=http://127.0.0.1:8010
# GIT_GRASP_POSTHOG_HOST=http://127.0.0.1:8010
# GIT_GRASP_POSTHOG_API_HOST=http://127.0.0.1:8010
