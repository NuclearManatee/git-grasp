# Umami — production Cloud defaults (public website id). Override for local Docker e2e.
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=de9735ab-4e95-479d-abf8-c52f7979e2aa

# Local Umami (optional):
# PUBLIC_UMAMI_SCRIPT_URL=http://127.0.0.1:3001/script.js
# PUBLIC_UMAMI_WEBSITE_ID=<id from bun run evolve:seed-umami>

# EVOLVE pull (pipeline). Local Docker fallback is http://127.0.0.1:3001
# GIT_GRASP_UMAMI_HOST=http://127.0.0.1:3001
# GIT_GRASP_UMAMI_WEBSITE_ID=
# GIT_GRASP_UMAMI_TOKEN=
# GIT_GRASP_UMAMI_USERNAME=admin
# GIT_GRASP_UMAMI_PASSWORD=umami
