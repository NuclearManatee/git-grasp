/*
  Exact security headers for git-help on GitHub Pages.
  GitHub Pages IGNORES this file. Use it only if you front the site with
  Cloudflare (DNS orange-cloud + Transform Rules), Cloudflare Pages, or Netlify.
  Copy these values into the edge config — see deploy notes in the security review.
*/
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is https://*.umami.is; connect-src 'self' https://huggingface.co https://*.huggingface.co https://cdn.jsdelivr.net https://cloud.umami.is https://*.umami.is; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
*/
