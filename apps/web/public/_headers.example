/*
  Exact security headers for git-help on GitHub Pages.
  GitHub Pages IGNORES this file. Use it only if you front the site with
  Cloudflare (DNS orange-cloud + Transform Rules), Cloudflare Pages, or Netlify.
  Copy these values into the edge config — see docs/security/OWASPREPORT.md (R1 deploy notes).
*/
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://*.i.posthog.com https://*.posthog.com; connect-src 'self' https://huggingface.co https://*.huggingface.co https://cdn.jsdelivr.net https://*.i.posthog.com https://*.posthog.com; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
*/
