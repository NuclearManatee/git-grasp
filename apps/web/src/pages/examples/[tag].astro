---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import RecipeCarousel from '../../components/examples/RecipeCarousel.astro';
import {
  loadRecipes,
  listTags,
  recipesForTag,
  toCarouselPayload,
  SPECIAL_TAGS,
} from '../../lib/recipesCatalog.js';

export function getStaticPaths() {
  const recipes = loadRecipes();
  const tags = listTags(recipes);
  const special = SPECIAL_TAGS.map((tag) => ({ params: { tag } }));
  const topicPaths = tags
    .filter(({ tag }) => !SPECIAL_TAGS.includes(tag))
    .map(({ tag }) => ({ params: { tag } }));
  return [...special, ...topicPaths];
}

const { tag } = Astro.params;
const recipes = loadRecipes();
const filtered = recipesForTag(tag, recipes);
const payload = toCarouselPayload(filtered);
const heading = tag === 'all' ? `All recipes (${filtered.length})` : `${tag} (${filtered.length})`;
---
<BaseLayout
  title={`${tag} · Examples · git-help`}
  description={`CLI-style carousel of git-help recipes tagged “${tag}”.`}
>
  <header class="border-b border-gh-border">
    <div class="gh-container flex items-center justify-between gap-4 py-4">
      <a href="/" class="font-mono text-lg font-semibold tracking-tight text-gh-fg">git-help</a>
      <nav class="flex gap-4 text-sm" aria-label="Primary">
        <a href="/examples" class="text-gh-muted hover:text-gh-fg">Examples</a>
        <a href="/#install" class="text-gh-muted hover:text-gh-fg">Install</a>
      </nav>
    </div>
  </header>

  <div id="main" class="flex flex-1 flex-col">
    <RecipeCarousel recipes={payload} heading={heading} tag={tag} />
  </div>

  <Footer />
</BaseLayout>
