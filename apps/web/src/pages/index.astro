---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContrastDemo from '../components/ContrastDemo.astro';
import Playground from '../components/playground/Playground';
import InstallSection from '../components/InstallSection.astro';
import DocsSection from '../components/DocsSection.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <main id="main">
    <Hero />
    <ContrastDemo />
    <Playground client:only="react">
      <div slot="fallback" class="gh-container py-16 text-gh-muted font-mono text-sm">
        Loading playground…
      </div>
    </Playground>
    <InstallSection />
    <DocsSection />
  </main>
  <Footer />
</BaseLayout>
