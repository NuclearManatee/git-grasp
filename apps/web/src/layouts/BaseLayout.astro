---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'git-help',
  description = 'Local-first semantic search for Git commands. Ask in natural language — get pasteable answers on your machine.',
} = Astro.props;

const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

/** Meta CSP — GitHub Pages cannot set response headers; pair with Cloudflare if possible. */
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "img-src 'self' data: https:",
  "font-src 'self' https://fonts.gstatic.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  // Astro islands + Transformers.js WASM need unsafe-inline / wasm-unsafe-eval
  "script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is https://*.umami.is",
  "connect-src 'self' https://huggingface.co https://*.huggingface.co https://cdn.jsdelivr.net https://cloud.umami.is https://*.umami.is",
  "worker-src 'self' blob:",
  "form-action 'self'",
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {umamiScript && umamiWebsiteId && (
      <script
        defer
        src={umamiScript}
        data-website-id={umamiWebsiteId}
        data-auto-track="true"
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-gh-accent focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
