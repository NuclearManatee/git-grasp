---
const repo = 'NuclearManatee/git-grasp';
const latest = `https://github.com/${repo}/releases/latest/download`;
const bunInstall = `bun add -g git-grasp
git-grasp "undo last commit but keep my files"`;
const binaries = [
  { label: 'Linux x64', file: 'git-grasp-linux-x64.zip' },
  { label: 'macOS Apple Silicon', file: 'git-grasp-darwin-arm64.zip' },
  { label: 'macOS Intel', file: 'git-grasp-darwin-x64.zip' },
  { label: 'Windows x64', file: 'git-grasp-windows-x64.zip' },
];
---
<section id="install" class="gh-container py-16 sm:py-20" aria-labelledby="install-heading">
  <div class="mb-8 max-w-xl">
    <h2 id="install-heading" class="font-mono text-2xl font-semibold sm:text-3xl">
      Install
    </h2>
    <p class="mt-3 text-gh-muted">
      Bun package (npm registry) or standalone binaries from GitHub Releases. Runtime for the package path requires Bun ≥ 1.1.
    </p>
  </div>

  <div class="gh-panel" data-tabs="install">
    <div role="tablist" aria-label="Install methods" class="flex border-b border-gh-border">
      <button
        type="button"
        role="tab"
        id="tab-bun"
        aria-controls="panel-bun"
        aria-selected="true"
        data-tab="bun"
        class="install-tab border-b-2 border-gh-accent px-4 py-3 text-sm font-medium text-gh-fg"
      >
        Bun
      </button>
      <button
        type="button"
        role="tab"
        id="tab-binaries"
        aria-controls="panel-binaries"
        aria-selected="false"
        data-tab="binaries"
        class="install-tab border-b-2 border-transparent px-4 py-3 text-sm font-medium text-gh-muted hover:text-gh-fg"
      >
        Binaries
      </button>
    </div>

    <div
      id="panel-bun"
      role="tabpanel"
      aria-labelledby="tab-bun"
      data-panel="bun"
      class="p-4"
    >
      <div class="relative">
        <pre class="overflow-x-auto rounded bg-gh-bg p-4 font-mono text-sm text-gh-fg"><code>{bunInstall}</code></pre>
        <button
          type="button"
          class="copy-btn absolute right-3 top-3 rounded border border-gh-border bg-gh-panel px-2 py-1 text-xs text-gh-muted hover:text-gh-fg"
          data-copy={bunInstall}
        >
          Copy
        </button>
      </div>
    </div>

    <div
      id="panel-binaries"
      role="tabpanel"
      aria-labelledby="tab-binaries"
      data-panel="binaries"
      class="hidden p-4"
      hidden
    >
      <p class="mb-4 text-sm text-gh-muted">
        Download the zip for your OS, extract, and run <code class="text-gh-fg">git-grasp</code> from that folder
        (includes <code class="text-gh-fg">data/</code> and <code class="text-gh-fg">config/</code>).
      </p>
      <ul class="space-y-2 font-mono text-sm">
        {binaries.map((b) => (
          <li>
            <a
              class="text-gh-accent underline-offset-2 hover:underline"
              href={`${latest}/${b.file}`}
            >
              {b.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-tabs="install"]');
  if (root) {
    const tabs = root.querySelectorAll('[role="tab"]');
    const panels = root.querySelectorAll('[role="tabpanel"]');

    function activate(name) {
      tabs.forEach((tab) => {
        const on = tab.getAttribute('data-tab') === name;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.classList.toggle('border-gh-accent', on);
        tab.classList.toggle('text-gh-fg', on);
        tab.classList.toggle('border-transparent', !on);
        tab.classList.toggle('text-gh-muted', !on);
      });
      panels.forEach((panel) => {
        const on = panel.getAttribute('data-panel') === name;
        panel.classList.toggle('hidden', !on);
        panel.hidden = !on;
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.getAttribute('data-tab')));
    });
  }

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = prev;
        }, 1500);
      } catch {
        btn.textContent = 'Failed';
      }
    });
  });
</script>
