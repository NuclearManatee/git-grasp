---
/** Use section — aligned with apps/cli/README.md Common commands / flags. */
const tabs = [
  {
    id: 'search',
    label: 'search',
    body: `git-grasp "<query>"
git-grasp search [query…]

Flags
  -v, --verbose   confidence / channel scores
  -c, --copy      copy winning example to clipboard
  --json          machine-readable JSON on stdout
  -q, --quiet     no spinner; skip telemetry invite

Never runs Git for you — pasteable suggestions only.

echo "undo last commit keep files" | git-grasp`,
  },
  {
    id: 'doctor',
    label: 'doctor / init',
    body: `git-grasp doctor
git-grasp init

doctor   DB, model, sqlite-vec, config (exit 2 on fail)
init     doctor checks + warm embedding model cache

git-grasp -V
catalog · schema · db identity`,
  },
  {
    id: 'telemetry',
    label: 'telemetry',
    body: `git-grasp telemetry on|off|status

CLI analytics: off by default (soft invite).
Hard off: DO_NOT_TRACK=1 or GIT_GRASP_TELEMETRY=0.

Playground: on after Start (consent). See /privacy.`,
  },
  {
    id: 'update',
    label: 'update-check',
    body: `git-grasp update-check on|off|status

Opt-in npm registry notices (off by default).
Hard off: GIT_GRASP_UPDATE_CHECK=0.

When newer: yellow stderr notice with install command.`,
  },
  {
    id: 'config',
    label: 'config',
    body: `git-grasp config show
git-grasp config path

User config (telemetry, update-check, parked skillLevel).
Platform path: %APPDATA%/git-grasp or ~/.config/git-grasp.`,
  },
  {
    id: 'completion',
    label: 'completion',
    body: `eval "$(git-grasp completion bash)"
eval "$(git-grasp completion zsh)"
git-grasp completion fish > ~/.config/fish/completions/git-grasp.fish
git-grasp completion powershell | Out-String | Invoke-Expression`,
  },
];
---
<section id="use" class="gh-container py-16 sm:py-20" aria-labelledby="use-heading">
  <div class="mb-8 max-w-xl">
    <h2 id="use-heading" class="font-mono text-2xl font-semibold sm:text-3xl">
      Use
    </h2>
    <p class="mt-3 text-gh-muted">
      Common commands from the CLI reference. Full docs in the repo under{' '}
      <span class="font-mono text-gh-fg">apps/cli/README.md</span>.
    </p>
  </div>

  <div class="gh-panel" data-tabs="use">
    <div role="tablist" aria-label="Usage reference" class="flex flex-wrap border-b border-gh-border">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`use-tab-${tab.id}`}
          aria-controls={`use-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab={tab.id}
          class:list={[
            'docs-tab border-b-2 px-4 py-3 text-sm font-medium',
            i === 0
              ? 'border-gh-accent text-gh-fg'
              : 'border-transparent text-gh-muted hover:text-gh-fg',
          ]}
        >
          {tab.label}
        </button>
      ))}
    </div>

    {tabs.map((tab, i) => (
      <div
        id={`use-panel-${tab.id}`}
        role="tabpanel"
        aria-labelledby={`use-tab-${tab.id}`}
        data-panel={tab.id}
        class:list={['p-4', i !== 0 && 'hidden']}
        hidden={i !== 0}
      >
        <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-sm text-gh-fg">{tab.body}</pre>
      </div>
    ))}
  </div>
</section>

<script>
  const root = document.querySelector('[data-tabs="use"]');
  if (root) {
    const tabs = root.querySelectorAll('[role="tab"]');
    const panels = root.querySelectorAll('[role="tabpanel"]');

    function activate(name) {
      tabs.forEach((tab) => {
        const on = tab.getAttribute('data-tab') === name;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.classList.toggle('border-gh-accent', on);
        tab.classList.toggle('text-gh-fg', on);
        tab.classList.toggle('border-transparent', !on);
        tab.classList.toggle('text-gh-muted', !on);
      });
      panels.forEach((panel) => {
        const on = panel.getAttribute('data-panel') === name;
        panel.classList.toggle('hidden', !on);
        panel.hidden = !on;
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.getAttribute('data-tab')));
    });
  }
</script>
