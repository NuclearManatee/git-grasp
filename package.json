{
  "name": "git-grasp",
  "version": "0.1.0",
  "description": "Semantic search CLI for Git commands",
  "license": "MIT",
  "type": "module",
  "private": false,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cremaschi/git-grasp.git"
  },
  "homepage": "https://git-grasp.cremaschi.dev",
  "bugs": {
    "url": "https://github.com/cremaschi/git-grasp/issues"
  },
  "bin": {
    "git-grasp": "./apps/cli/bin/index.ts"
  },
  "files": [
    "apps/cli/",
    "packages/core/",
    "data/",
    "config/",
    "scripts/postinstall.ts",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@huggingface/transformers": "^3.4.2",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "openai": "^7.1.0",
    "ora": "^8.2.0",
    "p-limit": "^7.3.1",
    "sql.js": "^1.14.1",
    "sqlite-vec": "^0.1.6",
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "bunx vitest run test/unit && bun test ./test/integration",
    "test:unit": "bunx vitest run test/unit",
    "test:integration": "bun test ./test/integration",
    "test:telemetry-e2e": "bun test ./test/integration/cli-telemetry-umami.test.ts",
    "test:watch": "bunx vitest",
    "bench:render-latest": "bun scripts/render-bench-latest.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "bun --filter @git-grasp/cli start",
    "doctor": "bun --filter @git-grasp/cli doctor",
    "seed": "bun --filter @git-grasp/seeding seed",
    "eval": "bun --filter @git-grasp/eval eval",
    "eval:loop": "bun --filter @git-grasp/eval loop",
    "taxonomy:scrape": "bun scripts/taxonomy-scrape.ts",
    "taxonomy:pins": "bun scripts/taxonomy-pins.ts",
    "smoke:pin-display": "bun scripts/smoke-pin-display.ts",
    "build:prepare": "bun scripts/build-prepare.ts",
    "build:ground": "bun scripts/build-ground.ts",
    "build:loop": "bun scripts/build-loop.ts",
    "build:loop:mock": "bun scripts/build-loop-mock-proof.ts",
    "ingest-sources": "bun scripts/ingest-sources.ts",
    "download-docs": "bun scripts/download-docs.ts",
    "rebuild": "bun scripts/build-loop.ts",
    "web:dev": "bun --filter @git-grasp/web dev",
    "web:build": "bun --filter @git-grasp/web build",
    "web:pack": "bun scripts/export-web-pack.ts",
    "web:e2e": "bun --filter @git-grasp/web e2e",
    "bench": "bun scripts/bench-search.ts",
    "bench:install": "bun scripts/bench-install.ts",
    "build:cli": "bun build --compile ./apps/cli/bin/index.ts --outfile ./bench/git-grasp",
    "build:release": "bun scripts/build-release-binary.ts",
    "postinstall": "bun scripts/postinstall.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "sharp": "0.35.0",
    "cookie": "1.1.1"
  }
}
