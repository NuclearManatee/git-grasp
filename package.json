{
  "name": "git-help",
  "version": "0.1.0",
  "description": "Semantic search CLI for Git commands",
  "license": "MIT",
  "type": "module",
  "private": false,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cremaschi/git-help.git"
  },
  "homepage": "https://git-help.cremaschi.dev",
  "bugs": {
    "url": "https://github.com/cremaschi/git-help/issues"
  },
  "bin": {
    "git-help": "./apps/cli/bin/index.js"
  },
  "files": [
    "apps/cli/",
    "packages/core/",
    "data/",
    "config/",
    "prompts/",
    "scripts/postinstall.js",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@huggingface/transformers": "^3.4.2",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0",
    "sqlite-vec": "^0.1.6"
  },
  "scripts": {
    "test": "bunx vitest run test/unit && bun test ./test/integration",
    "test:unit": "bunx vitest run test/unit",
    "test:integration": "bun test ./test/integration",
    "test:watch": "bunx vitest",
    "cli": "bun --filter @git-help/cli start",
    "doctor": "bun --filter @git-help/cli doctor",
    "seed": "bun --filter @git-help/seeding seed",
    "eval": "bun --filter @git-help/eval eval",
    "eval:loop": "bun --filter @git-help/eval loop",
    "eval:gen-dynamic": "bun scripts/gen-dynamic.js",
    "improve": "bun scripts/improve.js",
    "build-catalog": "bun scripts/build-catalog.js",
    "download-docs": "bun scripts/download-docs.js",
    "build-catalog:glossary": "bun scripts/build-catalog-glossary.js",
    "build-catalog:commands": "bun scripts/build-catalog-commands.js",
    "build-catalog:families": "bun scripts/build-catalog-families.js",
    "build-catalog:intents": "bun scripts/build-catalog-intents.js",
    "build-catalog:normalize": "bun scripts/build-catalog-normalize.js",
    "enrich-catalog": "bun scripts/enrich-catalog.js",
    "rebuild": "bun scripts/build-catalog.js && bun --filter @git-help/seeding seed",
    "web:dev": "bun --filter @git-help/web dev",
    "web:build": "bun --filter @git-help/web build",
    "web:pack": "bun scripts/export-web-pack.js",
    "web:e2e": "bun --filter @git-help/web e2e",
    "bench": "bun scripts/bench-search.js",
    "bench:install": "bun scripts/bench-install.js",
    "build:cli": "bun build --compile ./apps/cli/bin/index.js --outfile ./bench/git-help",
    "build:release": "bun scripts/build-release-binary.js",
    "postinstall": "bun scripts/postinstall.js"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  },
  "overrides": {
    "sharp": "0.35.0",
    "cookie": "1.1.1"
  }
}
